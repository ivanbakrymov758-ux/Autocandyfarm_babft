-- ===== ЗАГРУЗКА КУБОВ ИЗ TXT =====
local function loadAreas()
    AREAS = {}
    local ok, content = pcall(function() return readfile("candy_areas.txt") end)
    if not ok or not content then
        pcall(function() writefile("candy_areas.txt", "-- x1,y1,z1 | x2,y2,z2\n") end)
        return
    end
    for line in content:gmatch("[^\r\n]+") do
        line = line:gsub("%-%-.*",""):gsub("^%s+",""):gsub("%s+$","")
        if line == "" then continue end
        local p1, p2 = line:match("([^|]+)|(.+)")
        if p1 and p2 then
            local x1,y1,z1 = p1:match("([^,]+),([^,]+),([^,]+)")
            local x2,y2,z2 = p2:match("([^,]+),([^,]+),([^,]+)")
            if x1 and x2 then
                table.insert(AREAS, {
                    min = Vector3.new(
                        math.min(tonumber(x1),tonumber(x2)),
                        math.min(tonumber(y1),tonumber(y2)),
                        math.min(tonumber(z1),tonumber(z2))
                    ),
                    max = Vector3.new(
                        math.max(tonumber(x1),tonumber(x2)),
                        math.max(tonumber(y1),tonumber(y2)),
                        math.max(tonumber(z1),tonumber(z2))
                    )
                })
            end
        end
    end
end

local function saveAreasToFile()
    local lines = {"-- x1,y1,z1 | x2,y2,z2"}
    for _, a in pairs(AREAS) do
        table.insert(lines, string.format("%.1f,%.1f,%.1f | %.1f,%.1f,%.1f",
            a.min.X, a.min.Y, a.min.Z, a.max.X, a.max.Y, a.max.Z))
    end
    pcall(function() writefile("candy_areas.txt", table.concat(lines, "\n")) end)
end

local function isInAnyArea(pos)
    if #AREAS == 0 then return true end
    for _, a in pairs(AREAS) do
        if pos.X >= a.min.X and pos.X <= a.max.X
           and pos.Y >= a.min.Y and pos.Y <= a.max.Y
           and pos.Z >= a.min.Z and pos.Z <= a.max.Z then
            return true
        end
    end
    return false
end

-- ===== ВИЗУАЛИЗАЦИЯ КУБОВ =====
local visFolder = Instance.new("Folder")
visFolder.Name = "AutoFly_Visuals"
visFolder.Parent = Workspace

local function clearVisuals()
    for _, v in pairs(visFolder:GetChildren()) do v:Destroy() end
end

local function drawBox(min, max, color)
    local center = (min + max) / 2
    local size = max - min
    local part = Instance.new("Part")
    part.Name = "AreaBox"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 0.85
    part.Color = color or Color3.fromRGB(0, 255, 100)
    part.Material = Enum.Material.Neon
    part.Size = size
    part.CFrame = CFrame.new(center)
    part.Parent = visFolder

    local box = Instance.new("SelectionBox")
    box.Adornee = part
    box.LineThickness = 0.05
    box.Color3 = color or Color3.fromRGB(0, 255, 100)
    box.Transparency = 0.3
    box.Parent = part
end

local function redrawVisuals()
    clearVisuals()
    for _, a in pairs(AREAS) do
        drawBox(a.min, a.max, Color3.fromRGB(0, 255, 100))
    end
end

-- ===== ПОИСК ДОМА =====
local function findNearestHouseInArea(exclude)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local rootPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, obj in pairs(Workspace:GetDescendants()) do
        if exclude[obj] then continue end
        if obj:IsDescendantOf(visFolder) then continue end
        local name = obj.Name:lower()
        if (name:find("trick") or name:find("candy") or name:find("house"))
           and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local pos = obj:IsA("Model")
                and (obj.PrimaryPart and obj.PrimaryPart.Position
                     or (obj:FindFirstChildWhichIsA("BasePart") and obj:FindFirstChildWhichIsA("BasePart").Position))
                or obj.Position
            if pos and isInAnyArea(pos) then
                local d = (pos - rootPos).Magnitude
                if d < bestDist then bestDist = d; best = obj end
            end
        end
    end
    return best
end

local function findDoor(house)
    if not house then return nil end
    local door = house:FindFirstChild("Door", true) or house:FindFirstChild("door", true)
    if door and door:IsA("BasePart") then return door end
    if house:IsA("Model") then return house.PrimaryPart or house:FindFirstChildWhichIsA("BasePart") end
    return house
end

local function teleportToHouse(house)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local door = findDoor(house)
    if not door then return end
    hrp.CFrame = door.CFrame * CFrame.new(0, 3, -2)
end

-- ===== ЦИКЛ =====
local AutoFarm = false
local running = false
local visited = {}

local function loop()
    while running do
        if not AutoFarm then task.wait(0.3); continue end
        local house = findNearestHouseInArea(visited)
        if house then
            teleportToHouse(house)
            visited[house] = true
            task.wait(1.2)
        else
            task.wait(1.0)
        end
    end
end

